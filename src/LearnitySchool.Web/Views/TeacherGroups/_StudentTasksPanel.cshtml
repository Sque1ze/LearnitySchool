@using LearnitySchool.Domain.Enums
@model LearnitySchool.Web.ViewModels.Teacher.Groups.TeacherStudentTasksVm

<div class="student-panel">
    <div class="student-panel-head">
        <div class="title">Задачі учня: <span class="strong">@Model.StudentName</span></div>
        <div class="muted small">Зелений — зараховано, жовтий — чекає перевірки, червоний — не зараховано/повернуто, сірий — не виконано</div>
    </div>

    <div class="student-panel-body">
        @foreach (var lesson in Model.Lessons)
        {
            <div class="lesson-block">
                <div class="lesson-line">
                    <div class="lesson-title">
                        <span class="muted">@lesson.Order.</span> @lesson.Title
                    </div>
                </div>

                <div class="task-grid">
                    @if (lesson.Tasks.Count == 0)
                    {
                        <div class="muted small">Немає задач</div>
                    }
                    else
                    {
                        foreach (var t in lesson.Tasks)
                        {
                            var quizPassed = t.HasQuizAttempt && (t.QuizScorePercent ?? 0) >= 95;
                            var quizFailed = t.HasQuizAttempt && !quizPassed;
                            var cls = (t.IsCompleted || quizPassed) ? "done"
                                : quizFailed ? "returned"
                                : t.SubmissionStatus == StudentSubmissionStatus.PendingReview ? "pending"
                                : t.SubmissionStatus == StudentSubmissionStatus.Returned ? "returned"
                                : "todo";

                            var statusText = (t.IsCompleted || quizPassed) ? "зараховано"
                                : quizFailed ? $"квіз не зараховано ({t.QuizScorePercent}%)"
                                : t.SubmissionStatus == StudentSubmissionStatus.PendingReview ? "очікує перевірки"
                                : t.SubmissionStatus == StudentSubmissionStatus.Returned ? "повернуто"
                                : "не виконано";

                            <div class="task-square @cls"
                                 title="@lesson.Title — @t.Title — @statusText">
                                @t.Order
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>
