@using LearnitySchool.Application.Common

@{
    // За замовчуванням — без layout
    Layout = null;

    if (User?.Identity?.IsAuthenticated == true)
    {
        if (User.IsInRole(RoleNames.Manager))
        {
            Layout = "_LayoutManager";
        }
        else if (User.IsInRole(RoleNames.Teacher))
        {
            Layout = "_LayoutTeacher";
        }
        else if (User.IsInRole(RoleNames.Student))
        {
            Layout = "_LayoutStudent";
        }
        else
        {
            Layout = "_LayoutStudent";
        }
    }
}
