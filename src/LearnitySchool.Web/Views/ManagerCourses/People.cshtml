@model LearnitySchool.Web.ViewModels.Manager.Courses.CoursePeopleVm
@{
    ViewData["Title"] = "Люди";
}

<link rel="stylesheet" href="~/css/userManager/coursePeople.css" asp-append-version="true" />

<div class="users-page">

    <div class="users-header">
        <div>
            <h2 class="users-title">People — <span class="muted">@Model.CourseTitle</span></h2>
            <div class="sub">Признач викладача та додай учнів на курс</div>
        </div>

        <a asp-action="Index" class="btn btn-muted">← Back</a>
    </div>

    <form asp-action="People" method="post" class="card people-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="CourseId" value="@Model.CourseId" />

        <div class="form-grid">

            <div class="field">
                <label class="label">Teacher</label>
                <select name="TeacherUserId" class="select">
                    <option value="">— Без викладача —</option>
                    @foreach (var t in Model.Teachers)
                    {
                        <option value="@t.Value" selected="@(Model.TeacherUserId == t.Value)">@t.Text</option>
                    }
                </select>
            </div>

            <div class="field">
                <label class="label">Students</label>

                <select name="SelectedStudentIds" multiple size="12" class="select select-multi">
                    @foreach (var s in Model.Students)
                    {
                        var selected = Model.SelectedStudentIds.Contains(s.Value ?? "");
                        <option value="@s.Value" selected="@(selected ? "selected" : null)">@s.Text</option>
                    }
                </select>

                <div class="hint">
                    Порада: щоб вибрати декількох — тримай <b>Ctrl</b> (Windows) / <b>Cmd</b> (Mac)
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn">Back</a>
            </div>

            <div asp-validation-summary="All" class="validation"></div>
        </div>
    </form>

</div>
