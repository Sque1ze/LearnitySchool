@model LearnitySchool.Web.ViewModels.Manager.Courses.CourseCloneVm
@{
    ViewData["Title"] = "Копіювати курс";
}

<link rel="stylesheet" href="~/css/userManager/coursePeople.css" asp-append-version="true" />

<div class="users-page">
    <div class="users-header">
        <div>
            <h2 class="users-title">Копіювати курс — <span class="muted">@Model.SourceCourseTitle</span></h2>
            <div class="sub">
                Буде створено новий курс з такими самими уроками, завданнями, quiz options, practice/reference та розкладом.
                Прогрес, оплати, здачі робіт і чернетки учнів не копіюються.
            </div>
        </div>
        <a asp-action="Index" class="btn btn-muted">← Назад</a>
    </div>

    <form asp-action="Clone" method="post" class="card people-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="SourceCourseId" />
        <input type="hidden" asp-for="SourceCourseTitle" />
        <input type="hidden" asp-for="LessonsCount" />
        <input type="hidden" asp-for="TasksCount" />

        <div class="form-grid">
            <div class="field">
                <label asp-for="Title" class="label">Назва нового курсу</label>
                <input asp-for="Title" class="input" />
                <span asp-validation-for="Title" class="validation"></span>
            </div>

            <div class="field">
                <label asp-for="Description" class="label">Опис</label>
                <textarea asp-for="Description" class="input" rows="4"></textarea>
                <span asp-validation-for="Description" class="validation"></span>
            </div>

            <label class="field" style="display:flex;align-items:center;gap:10px;">
                <input asp-for="IsPublished" />
                <span>Опублікувати копію курсу</span>
            </label>

            <div class="hint">
                У копії буде: <b>@Model.LessonsCount</b> уроків і <b>@Model.TasksCount</b> завдань. Нижче можна одразу вибрати викладача та нових учнів для копії.
            </div>

            <div class="field searchable-field">
                <label class="label">Викладач для копії</label>
                <input type="search" class="input search-input" data-target="teacherSelect" placeholder="Пошук викладача за ім’ям або email..." autocomplete="off" />
                <select id="teacherSelect" name="TeacherUserId" class="select">
                    <option value="">— Без викладача —</option>
                    @foreach (var t in Model.Teachers)
                    {
                        <option value="@t.Value" selected="@(Model.TeacherUserId == t.Value)">@t.Text</option>
                    }
                </select>
                <div class="hint">За замовчуванням підставляється викладач з оригінального курсу, але його можна змінити.</div>
            </div>

            <div class="field searchable-field">
                <label class="label">Учні для копії</label>
                <div class="student-tools">
                    <input type="search" class="input search-input" data-target="studentsSelect" placeholder="Пошук учня..." autocomplete="off" />
                    <button type="button" class="btn btn-small" id="clearStudentFilter">Очистити</button>
                </div>

                <select id="studentsSelect" name="SelectedStudentIds" multiple size="12" class="select select-multi">
                    @foreach (var s in Model.Students)
                    {
                        var selected = Model.SelectedStudentIds?.Contains(s.Value ?? "") ?? false;
                        <option value="@s.Value" selected="@selected">@s.Text</option>
                    }
                </select>

                <div class="hint">
                    Можна вибрати інших учнів для копії. Щоб вибрати декількох — тримайте <b>Ctrl</b> (Windows) / <b>Cmd</b> (Mac).
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Створити копію курсу</button>
                <a asp-action="Index" class="btn">Назад</a>
            </div>

            <div asp-validation-summary="All" class="validation"></div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    (() => {
        function normalize(value) {
            return (value || "").toString().trim().toLowerCase();
        }

        function filterSelect(input) {
            const select = document.getElementById(input.dataset.target);
            if (!select) return;

            const term = normalize(input.value);
            Array.from(select.options).forEach(option => {
                if (!option.value) return;
                const text = normalize(option.textContent);
                const isSelected = option.selected;
                option.hidden = term.length > 0 && !text.includes(term) && !isSelected;
            });
        }

        document.querySelectorAll(".search-input[data-target]").forEach(input => {
            input.addEventListener("input", () => filterSelect(input));
            filterSelect(input);
        });

        const clearBtn = document.getElementById("clearStudentFilter");
        clearBtn?.addEventListener("click", () => {
            const input = document.querySelector('.search-input[data-target="studentsSelect"]');
            if (!input) return;
            input.value = "";
            filterSelect(input);
            input.focus();
        });
    })();
    </script>
}
