@model LearnitySchool.Web.ViewModels.Manager.Courses.CourseEditVm
@{
    ViewData["Title"] = "Видалити курс";
}

<link rel="stylesheet" href="~/css/userManager/courseDelete.css" asp-append-version="true" />

<div class="users-page">

    <div class="users-header">
        <div>
            <h2 class="users-title">Видалити курс</h2>
            <div class="sub">Підтвердження видалення</div>
        </div>

        <a asp-action="Index" class="btn btn-muted">← Назад</a>
    </div>

    <div class="card delete-card">
        <div class="delete-title">@Model.Title</div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="delete-desc">@Model.Description</div>
        }

        <div class="delete-meta">
            Статус: <strong>@(Model.IsPublished ? "Published" : "Draft")</strong>
        </div>

        <div class="danger-box">
            ⚠️ Увага: курс буде видалений разом з уроками, розкладом та призначеними людьми (якщо вони є).
        </div>

        <form asp-action="DeleteConfirmed" method="post" class="delete-actions">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <button type="submit" class="btn btn-danger">
                Так, видалити
            </button>

            <a asp-action="Index" class="btn">
                Скасувати
            </a>
        </form>
    </div>

</div>
