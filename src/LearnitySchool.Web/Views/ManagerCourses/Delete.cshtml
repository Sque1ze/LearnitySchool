@model LearnitySchool.Web.ViewModels.Manager.Courses.CourseEditVm
@{
    ViewData["Title"] = "Видалити курс";
}

<h2 style="margin:0 0 12px 0;">Видалити курс</h2>

<div style="padding:14px; border:1px solid #1F2933; border-radius:14px; background:#020617; max-width:820px;">
    <div style="font-weight:700; font-size:18px; margin-bottom:6px;">
        @Model.Title
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div style="opacity:.8; margin-bottom:10px;">
            @Model.Description
        </div>
    }

    <div style="opacity:.8;">
        Статус: <strong>@(Model.IsPublished ? "Published" : "Draft")</strong>
    </div>

    <div style="margin-top:14px; padding:12px; border:1px solid #1F2933; border-radius:12px;">
        ⚠️ Увага: курс буде видалений разом з уроками, розкладом та призначеними людьми (якщо вони є).
    </div>

    <form asp-action="DeleteConfirmed" method="post" style="margin-top:14px; display:flex; gap:10px; flex-wrap:wrap;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <button type="submit" class="dropdown-btn" style="border-color:#ef4444;">
            Так, видалити
        </button>

        <a asp-action="Index" class="dropdown-btn">
            Скасувати
        </a>
    </form>
</div>
