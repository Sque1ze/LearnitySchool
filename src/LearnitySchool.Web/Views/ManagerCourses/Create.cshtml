@model LearnitySchool.Web.ViewModels.Manager.Courses.CourseEditVm
@{
    ViewData["Title"] = "Створити курс";
}

<link rel="stylesheet" href="~/css/userManager/courseCreate.css" asp-append-version="true" />

<div class="users-page">

    <div class="users-header">
        <div>
            <h2 class="users-title">Створити курс</h2>
            <div class="sub">Заповніть основні дані курсу</div>
        </div>

        <a asp-action="Index" class="btn btn-muted">← Назад</a>
    </div>

    <form asp-action="Create" method="post" class="card course-form">
        @Html.AntiForgeryToken()

        <div class="form-grid">
            <div class="field">
                <label class="label">Назва курсу</label>
                <input name="Title" value="@Model.Title" placeholder="Напр. C# для початківців" class="input" />
            </div>

            <div class="field">
                <label class="label">Опис (опційно)</label>
                <textarea name="Description" placeholder="Коротко: що буде в курсі" class="textarea" rows="6">@Model.Description</textarea>
            </div>

            <label class="check">
                <input type="checkbox" name="IsPublished" value="true" @(Model.IsPublished ? "checked" : "") />
                <span class="check__box" aria-hidden="true"></span>
                <span class="check__text">Опублікувати курс</span>
            </label>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Index" class="btn">Cancel</a>
            </div>

            <div asp-validation-summary="All" class="validation"></div>
        </div>
    </form>

</div>
