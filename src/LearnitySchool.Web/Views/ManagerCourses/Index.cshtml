@model List<LearnitySchool.Web.ViewModels.Manager.Courses.CourseEditVm>
@{
    ViewData["Title"] = "Курси";
}

<link rel="stylesheet" href="~/css/userManager/courseIndex.css" asp-append-version="true" />

<div class="users-page">
    <div class="users-header">
        <h2 class="users-title">Курси</h2>
        <a asp-action="Create" class="btn btn-primary">+ Створити курс</a>
    </div>

    <div class="card">
        <table class="users-table courses-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th style="width:140px;">Published</th>
                    <th style="width:320px;"></th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="empty">Немає курсів</td>
                    </tr>
                }
                else
                {
                    foreach (var c in Model)
                    {
                        <tr>
                            <td>
                                <div class="course-title">@c.Title</div>

                                @if (!string.IsNullOrWhiteSpace(c.Description))
                                {
                                    <div class="course-desc">@c.Description</div>
                                }
                            </td>

                            <td>
                                @if (c.IsPublished)
                                {
                                    <span class="pill pill-success">✅ Published</span>
                                }
                                else
                                {
                                    <span class="pill pill-muted">— Draft</span>
                                }
                            </td>

                            <td class="actions">
                                <a asp-action="People" asp-route-id="@c.Id">People</a>
                                <span>·</span>

                                <a asp-controller="ManagerLessons"
                                       asp-action="Index"
                                       asp-route-courseId="@c.Id">
                                    Lessons
                                </a>
                                <span>·</span>

                                <a asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                                <span>·</span>

                                <a asp-action="Delete" asp-route-id="@c.Id">Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
