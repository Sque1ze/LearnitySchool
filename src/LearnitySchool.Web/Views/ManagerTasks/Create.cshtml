@using LearnitySchool.Domain.Enums
@model LearnitySchool.Web.ViewModels.Manager.Tasks.TaskEditVm
@{
    ViewData["Title"] = "Create Task";
}

<link rel="stylesheet" href="~/css/userManager/tasks.css" asp-append-version="true" />

<div class="users-page">

    <div class="users-header">
        <div>
            <h2 class="users-title">Create Task — <span class="muted">@Model.LessonTitle</span></h2>
            <div class="sub">Створіть завдання для уроку</div>
        </div>

        <a asp-action="Index" asp-route-lessonId="@Model.LessonId" class="btn btn-muted">← Back</a>
    </div>

    <form asp-action="Create" method="post" class="card">
        @Html.AntiForgeryToken()

        <input type="hidden" name="LessonId" value="@Model.LessonId" />

        <div class="form-grid">
            <div class="grid-2">
                <div class="field">
                    <label class="label">Order</label>
                    <input name="Order" value="@Model.Order" placeholder="Напр. 1" class="input" />
                </div>

                <div class="field">
                    <label class="label">Title</label>
                    <input name="Title" value="@Model.Title" placeholder="Назва завдання" class="input" />
                </div>
            </div>

            <div class="grid-2">
                <div class="field">
                    <label class="label">Type</label>
                    <select name="Type" class="select">
                        <option value="@((int)LessonTaskType.Quiz)" selected="@(Model.Type == LessonTaskType.Quiz)">Quiz</option>
                        <option value="@((int)LessonTaskType.Practice)" selected="@(Model.Type == LessonTaskType.Practice)">Practice</option>
                    </select>
                </div>

                <div class="field">
                    <label class="label">Тип квіза</label>
                    <select name="QuizType" class="select">
                        <option value="@((int)QuizType.Standard)" selected="@(Model.QuizType == QuizType.Standard)">Standard — звичайний</option>
                        <option value="@((int)QuizType.Matching)" selected="@(Model.QuizType == QuizType.Matching)">Matching — з’єднати пари</option>
                        <option value="@((int)QuizType.FillBlank)" selected="@(Model.QuizType == QuizType.FillBlank)">FillBlank — пропуски</option>
                    </select>
                    <div class="hint">Використовується тільки для завдань типу Quiz.</div>
                </div>

                <div class="field">
                    <label class="label">Перевірка</label>
                    <select name="AssessmentMode" class="select">
                        <option value="@((int)TaskAssessmentMode.AutoPercent)" selected="@(Model.AssessmentMode == TaskAssessmentMode.AutoPercent)">Автоматично по %</option>
                        <option value="@((int)TaskAssessmentMode.TeacherReview)" selected="@(Model.AssessmentMode == TaskAssessmentMode.TeacherReview)">На перевірку вчителю</option>
                    </select>
                    <div class="hint">Для Practice можна або рахувати %, або приймати роботу вручну.</div>
                </div>
            </div>

            <div class="field">
                <label class="label">Description</label>
                <textarea name="Description" placeholder="Опис завдання" class="textarea" rows="6">@Model.Description</textarea>
            </div>

            <label class="check">
                <input type="checkbox" name="IsPublished" value="true" @(Model.IsPublished ? "checked" : "") />
                <span class="check__box" aria-hidden="true"></span>
                <span class="check__text">Published</span>
            </label>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Index" asp-route-lessonId="@Model.LessonId" class="btn">Back</a>
            </div>

            <div asp-validation-summary="All" class="validation"></div>
        </div>
    </form>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
