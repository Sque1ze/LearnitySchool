@model LearnitySchool.Web.ViewModels.Manager.Tasks.TaskEditVm
@{
    ViewData["Title"] = "Delete Task";
}

<link rel="stylesheet" href="~/css/userManager/tasks.css" asp-append-version="true" />

<div class="users-page">

    <div class="users-header">
        <div>
            <h2 class="users-title">Delete Task — <span class="muted">@Model.LessonTitle</span></h2>
            <div class="sub">Підтвердження видалення завдання</div>
        </div>

        <a asp-action="Index" asp-route-lessonId="@Model.LessonId" class="btn btn-muted">← Back</a>
    </div>

    <div class="card">

        <div style="font-weight:700; font-size:18px;">
            @Model.Order. @Model.Title
        </div>

        <div class="danger-box">
            ⚠️ Завдання буде видалене.
        </div>

        <form asp-action="DeleteConfirmed" method="post" class="form-actions" style="margin-top:14px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="lessonId" value="@Model.LessonId" />

            <button type="submit" class="btn btn-danger">Так, видалити</button>
            <a asp-action="Index" asp-route-lessonId="@Model.LessonId" class="btn">Cancel</a>
        </form>

    </div>

</div>
