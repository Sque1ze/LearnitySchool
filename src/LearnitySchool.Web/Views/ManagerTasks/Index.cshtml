@using LearnitySchool.Domain.Enums
@model List<LearnitySchool.Web.ViewModels.Manager.Tasks.TaskListItemVm>

@{
    ViewData["Title"] = "Tasks";
    var lessonId = (Guid)ViewBag.LessonId;
    var lessonTitle = (string)ViewBag.LessonTitle;

    // ✅ потрібно передати з контролера
    var courseId = (Guid)ViewBag.CourseId;
}

<div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
    <div>
        <h2 style="margin:0;">Tasks — @lessonTitle</h2>
        <div style="opacity:.75; margin-top:4px;">Завдання всередині уроку</div>
    </div>

    <div style="display:flex; gap:10px;">
        <a asp-controller="ManagerLessons"
           asp-action="Index"
           asp-route-courseId="@courseId"
           class="dropdown-btn">
            Back
        </a>

        <a asp-action="Create"
           asp-route-lessonId="@lessonId"
           class="dropdown-btn">
            + Add task
        </a>
    </div>
</div>

<div style="margin-top:16px; overflow:auto;">
    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">Order</th>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">Title</th>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">Type</th>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">Published</th>
                <th style="padding:10px; border-bottom:1px solid #1F2933;"></th>
            </tr>
        </thead>

        <tbody>
            @if (Model == null || Model.Count == 0)
            {
                <tr>
                    <td colspan="5" style="padding:14px; opacity:.75;">Немає завдань</td>
                </tr>
            }
            else
            {
                foreach (var t in Model)
                {
                    <tr>
                        <td style="padding:10px; border-bottom:1px solid #1F2933;">@t.Order</td>

                        <td style="padding:10px; border-bottom:1px solid #1F2933; font-weight:600;">
                            @t.Title
                        </td>

                        <td style="padding:10px; border-bottom:1px solid #1F2933;">@t.Type</td>

                        <td style="padding:10px; border-bottom:1px solid #1F2933;">
                            @(t.IsPublished ? "✅" : "—")
                        </td>

                        <td style="padding:10px; border-bottom:1px solid #1F2933; white-space:nowrap;">
                            <a asp-action="Edit" asp-route-id="@t.Id">Edit</a>

                            @if (t.Type == LessonTaskType.Quiz)
                            {
                                <span style="opacity:.5;"> | </span>
                                <a asp-controller="ManagerQuiz"
                                   asp-action="Quiz"
                                   asp-route-taskId="@t.Id">
                                    Quiz builder
                                </a>
                            }

                            @if (t.Type == LessonTaskType.Practice)
                            {
                                <span style="opacity:.5;"> | </span>
                                <a asp-controller="ManagerPractice"
                                   asp-action="Edit"
                                   asp-route-taskId="@t.Id">
                                    Practice builder
                                </a>
                            }

                            <span style="opacity:.5;"> | </span>
                            <a asp-action="Delete" asp-route-id="@t.Id">Delete</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
