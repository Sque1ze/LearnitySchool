@using LearnitySchool.Domain.Enums
@model List<LearnitySchool.Web.ViewModels.Manager.Tasks.TaskListItemVm>

@{
    ViewData["Title"] = "Tasks";
    var lessonId = (Guid)ViewBag.LessonId;
    var lessonTitle = (string)ViewBag.LessonTitle;
    var courseId = (Guid)ViewBag.CourseId;
}

<link rel="stylesheet" href="~/css/userManager/tasks.css" asp-append-version="true" />

<div class="users-page">

    <div class="users-header">
        <div>
            <h2 class="users-title">Tasks — <span class="muted">@lessonTitle</span></h2>
            <div class="sub">Завдання всередині уроку</div>
        </div>

        <div class="header-actions">
            <a asp-controller="ManagerLessons"
               asp-action="Index"
               asp-route-courseId="@courseId"
               class="btn btn-muted">← Back</a>

            <a asp-action="Create"
               asp-route-lessonId="@lessonId"
               class="btn btn-primary">+ Add task</a>
        </div>
    </div>

    <div class="card" style="max-width:none;">
        <table class="users-table">
            <thead>
                <tr>
                    <th style="width:90px;">Order</th>
                    <th>Title</th>
                    <th style="width:140px;">Type</th>
                    <th style="width:150px;">Quiz</th>
                    <th style="width:190px;">Перевірка</th>
                    <th style="width:150px;">Published</th>
                    <th style="width:360px;"></th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="empty">Немає завдань</td>
                    </tr>
                }
                else
                {
                    foreach (var t in Model)
                    {
                        <tr>
                            <td class="cell-muted">@t.Order</td>

                            <td class="strong">@t.Title</td>

                            <td>
                                <span class="pill pill-type">@t.Type</span>
                            </td>

                            <td>
                                @(t.Type == LessonTaskType.Quiz ? t.QuizType.ToString() : "—")
                            </td>

                            <td>
                                @if (t.AssessmentMode == TaskAssessmentMode.TeacherReview)
                                {
                                    <span class="pill pill-warning">🟡 На перевірку</span>
                                }
                                else
                                {
                                    <span class="pill pill-info">% Авто</span>
                                }
                            </td>

                            <td>
                                @if (t.IsPublished)
                                {
                                    <span class="pill pill-success">✅ Published</span>
                                }
                                else
                                {
                                    <span class="pill pill-muted">— Draft</span>
                                }
                            </td>

                            <td class="actions">
                                <a asp-action="Edit" asp-route-id="@t.Id">Edit</a>

                                @if (t.Type == LessonTaskType.Quiz)
                                {
                                    <span>·</span>
                                    <a asp-controller="ManagerQuiz"
                                       asp-action="Quiz"
                                       asp-route-taskId="@t.Id">Quiz builder</a>
                                }

                                @if (t.Type == LessonTaskType.Practice)
                                {
                                    <span>·</span>
                                    <a asp-controller="ManagerPractice"
                                       asp-action="Edit"
                                       asp-route-taskId="@t.Id">Practice builder</a>
                                }

                                <span>·</span>
                                <a asp-action="Delete" asp-route-id="@t.Id">Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>
