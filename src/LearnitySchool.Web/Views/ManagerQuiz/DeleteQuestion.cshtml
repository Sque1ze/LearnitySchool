@model LearnitySchool.Web.ViewModels.Manager.Quiz.QuizQuestionEditVm
@{
    ViewData["Title"] = "Delete question";
}

<link rel="stylesheet" href="~/css/userManager/quiz.css" asp-append-version="true" />

<div class="users-page">

    <div class="users-header">
        <div>
            <h2 class="users-title">Delete question</h2>
            <div class="sub">Підтвердження видалення</div>
        </div>

        <a asp-action="Quiz" asp-route-taskId="@Model.TaskId" class="btn btn-muted">← Back</a>
    </div>

    <div class="card">
        <div class="cell-muted">Are you sure?</div>
        <div style="margin-top:8px;"><strong>@Model.Order.</strong> @Model.Text</div>

        <div class="danger-box">⚠️ Питання буде видалене.</div>

        <form asp-action="DeleteQuestionConfirmed" method="post" class="form-actions" style="margin-top:14px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Quiz" asp-route-taskId="@Model.TaskId" class="btn">Cancel</a>
        </form>
    </div>

</div>
