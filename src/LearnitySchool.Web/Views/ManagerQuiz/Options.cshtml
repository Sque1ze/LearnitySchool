@model List<LearnitySchool.Web.ViewModels.Manager.Quiz.QuizOptionListItemVm>

@{
    ViewData["Title"] = "Options";
    var questionId = (Guid)ViewBag.QuestionId;
    var taskId = (Guid)ViewBag.TaskId;
    var questionText = (string)ViewBag.QuestionText;
}

<div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
    <div>
        <h2 style="margin:0;">Options</h2>
        <div style="opacity:.75; margin-top:4px;">@questionText</div>
    </div>

    <div style="display:flex; gap:10px;">
        <a asp-action="Quiz" asp-route-taskId="@taskId" class="dropdown-btn">← Back</a>
        <a asp-action="CreateOption" asp-route-questionId="@questionId" class="dropdown-btn">+ Add option</a>
    </div>
</div>

<div style="margin-top:16px; overflow:auto;">
    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">#</th>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">Text</th>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">Correct</th>
                <th style="padding:10px; border-bottom:1px solid #1F2933;"></th>
            </tr>
        </thead>

        <tbody>
            @if (Model == null || Model.Count == 0)
            {
                <tr>
                    <td colspan="4" style="padding:14px; opacity:.75;">Опцій ще немає</td>
                </tr>
            }
            else
            {
                foreach (var o in Model)
                {
                    <tr>
                        <td style="padding:10px; border-bottom:1px solid #1F2933;">@o.Order</td>
                        <td style="padding:10px; border-bottom:1px solid #1F2933;">@o.Text</td>
                        <td style="padding:10px; border-bottom:1px solid #1F2933;">@(o.IsCorrect ? "✅" : "—")</td>
                        <td style="padding:10px; border-bottom:1px solid #1F2933; white-space:nowrap;">
                            <a asp-action="EditOption" asp-route-id="@o.Id">Edit</a>
                            <span style="opacity:.5;"> | </span>
                            <a asp-action="DeleteOption" asp-route-id="@o.Id">Delete</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
