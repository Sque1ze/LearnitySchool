@model List<LearnitySchool.Web.ViewModels.Manager.Quiz.QuizOptionListItemVm>

@{
    ViewData["Title"] = "Options";
    var questionId = (Guid)ViewBag.QuestionId;
    var taskId = (Guid)ViewBag.TaskId;
    var questionText = (string)ViewBag.QuestionText;
}

<link rel="stylesheet" href="~/css/userManager/quiz.css" asp-append-version="true" />

<div class="users-page">

    <div class="users-header">
        <div>
            <h2 class="users-title">Options</h2>
            <div class="sub">@questionText</div>
        </div>

        <div class="header-actions">
            <a asp-action="Quiz" asp-route-taskId="@taskId" class="btn btn-muted">← Back</a>
            <a asp-action="CreateOption" asp-route-questionId="@questionId" class="btn btn-primary">+ Add option</a>
        </div>
    </div>

    <div class="card" style="max-width:none;">
        <table class="table">
            <thead>
                <tr>
                    <th style="width:90px;">#</th>
                    <th>Text</th>
                    <th style="width:140px;">Correct</th>
                    <th style="width:220px;"></th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr><td colspan="4" class="empty">Опцій ще немає</td></tr>
                }
                else
                {
                    foreach (var o in Model)
                    {
                        <tr>
                            <td class="cell-muted">@o.Order</td>
                            <td>@o.Text</td>
                            <td>
                                @if (o.IsCorrect)
                                {
                                    <span class="pill pill-success">✅ Correct</span>
                                }
                                else
                                {
                                    <span class="pill pill-muted">—</span>
                                }
                            </td>
                            <td class="actions">
                                <a asp-action="EditOption" asp-route-id="@o.Id">Edit</a>
                                <span>·</span>
                                <a asp-action="DeleteOption" asp-route-id="@o.Id">Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>
