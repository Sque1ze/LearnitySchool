@model LearnitySchool.Web.ViewModels.Manager.Quiz.QuizOptionEditVm

@{
    ViewData["Title"] = "Delete option";
}

<h2>Delete option</h2>

<div style="border:1px solid #1F2933; border-radius:12px; padding:14px; max-width:720px;">
    <div style="opacity:.8;">Are you sure?</div>
    <div style="margin-top:8px;"><strong>@Model.Order.</strong> @Model.Text</div>

    <form asp-action="DeleteOptionConfirmed" method="post" style="margin-top:14px; display:flex; gap:10px;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="dropdown-btn">Delete</button>
        <a asp-action="Options" asp-route-questionId="@Model.QuestionId" class="dropdown-btn">Cancel</a>
    </form>
</div>
