@model LearnitySchool.Web.ViewModels.Manager.Quiz.QuizOptionEditVm

@{
    ViewData["Title"] = "Add option";
}

<h2>Add option</h2>

<form asp-action="CreateOption" method="post" style="max-width:720px; display:grid; gap:12px;">
    @Html.AntiForgeryToken()

    <input type="hidden" name="QuestionId" value="@Model.QuestionId" />

    <input name="Order" value="@Model.Order" class="dropdown-btn" placeholder="Order (1..)" />
    <input name="Text" value="@Model.Text" class="dropdown-btn" placeholder="Option text" />

    <label style="display:flex; gap:8px; align-items:center; opacity:.9;">
        <input type="checkbox" name="IsCorrect" value="true" @(Model.IsCorrect ? "checked" : "") />
        Correct answer
    </label>

    <div style="display:flex; gap:10px;">
        <button type="submit" class="dropdown-btn">Save</button>
        <a asp-action="Options" asp-route-questionId="@Model.QuestionId" class="dropdown-btn">Back</a>
    </div>

    <div asp-validation-summary="All"></div>
</form>
