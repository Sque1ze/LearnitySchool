@model LearnitySchool.Web.ViewModels.Manager.Quiz.QuizOptionEditVm
@{
    ViewData["Title"] = "Add option";
}

<link rel="stylesheet" href="~/css/userManager/quiz.css" asp-append-version="true" />

<div class="users-page">

    <div class="users-header">
        <div>
            <h2 class="users-title">Add option</h2>
            <div class="sub">Додайте варіант відповіді</div>
        </div>

        <a asp-action="Options" asp-route-questionId="@Model.QuestionId" class="btn btn-muted">← Back</a>
    </div>

    <form asp-action="CreateOption" method="post" class="card">
        @Html.AntiForgeryToken()
        <input type="hidden" name="QuestionId" value="@Model.QuestionId" />

        <div class="form-grid">
            <div class="grid-2">
                <div class="field">
                    <label class="label">Order</label>
                    <input name="Order" value="@Model.Order" class="input" placeholder="1.." />
                </div>

                <div class="field">
                    <label class="label">Option text</label>
                    <input name="Text" value="@Model.Text" class="input" placeholder="Option text" />
                </div>
            </div>

            <label class="check">
                <input type="checkbox" name="IsCorrect" value="true" @(Model.IsCorrect ? "checked" : "") />
                <span class="check__box" aria-hidden="true"></span>
                <span class="check__text">Correct answer</span>
            </label>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Options" asp-route-questionId="@Model.QuestionId" class="btn">Back</a>
            </div>

            <div asp-validation-summary="All" class="validation"></div>
        </div>
    </form>

</div>
