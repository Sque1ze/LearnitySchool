@model LearnitySchool.Web.ViewModels.Manager.Quiz.QuizQuestionEditVm
@{
    ViewData["Title"] = "Add question";
}

<link rel="stylesheet" href="~/css/userManager/quiz.css" asp-append-version="true" />

<div class="users-page">

    <div class="users-header">
        <div>
            <h2 class="users-title">Add question</h2>
            <div class="sub">Створіть питання для Quiz</div>
        </div>

        <a asp-action="Quiz" asp-route-taskId="@Model.TaskId" class="btn btn-muted">← Back</a>
    </div>

    <form asp-action="CreateQuestion" method="post" class="card">
        @Html.AntiForgeryToken()
        <input type="hidden" name="TaskId" value="@Model.TaskId" />

        <div class="form-grid">
            <div class="grid-2">
                <div class="field">
                    <label class="label">Order</label>
                    <input name="Order" value="@Model.Order" class="input" placeholder="1.." />
                </div>
                <div></div>
            </div>

            <div class="field">
                <label class="label">Question text</label>
                <textarea name="Text" class="textarea textarea-lg" placeholder="Question text">@Model.Text</textarea>
            </div>

            <label class="check">
                <input type="checkbox" name="IsPublished" value="true" @(Model.IsPublished ? "checked" : "") />
                <span class="check__box" aria-hidden="true"></span>
                <span class="check__text">Published</span>
            </label>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Quiz" asp-route-taskId="@Model.TaskId" class="btn">Back</a>
            </div>

            <div asp-validation-summary="All" class="validation"></div>
        </div>
    </form>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
