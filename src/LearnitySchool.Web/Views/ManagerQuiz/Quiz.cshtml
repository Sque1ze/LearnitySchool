@model List<LearnitySchool.Web.ViewModels.Manager.Quiz.QuizQuestionListItemVm>

@{
    ViewData["Title"] = "Quiz Questions";
    var taskId = (Guid)ViewBag.TaskId;
    var taskTitle = (string)ViewBag.TaskTitle;
}

<link rel="stylesheet" href="~/css/userManager/quiz.css" asp-append-version="true" />

<div class="users-page">

    <div class="users-header">
        <div>
            <h2 class="users-title">Quiz — <span class="muted">@taskTitle</span></h2>
            <div class="sub">Питання для цього Quiz</div>
        </div>

        <a asp-action="CreateQuestion" asp-route-taskId="@taskId" class="btn btn-primary">+ Add question</a>
    </div>

    <div class="card" style="max-width:none;">
        <table class="table">
            <thead>
                <tr>
                    <th style="width:90px;">#</th>
                    <th>Text</th>
                    <th style="width:120px;">Options</th>
                    <th style="width:140px;">Correct</th>
                    <th style="width:260px;"></th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr><td colspan="5" class="empty">Питань ще немає</td></tr>
                }
                else
                {
                    foreach (var q in Model)
                    {
                        <tr>
                            <td class="cell-muted">@q.Order</td>
                            <td>@q.Text</td>
                            <td>@q.OptionsCount</td>
                            <td>
                                @if (q.HasCorrectOption)
                                {
                                    <span class="pill pill-success">✅ Has correct</span>
                                }
                                else
                                {
                                    <span class="pill pill-muted">— Missing</span>
                                }
                            </td>
                            <td class="actions">
                                <a asp-action="Options" asp-route-questionId="@q.Id">Options</a>
                                <span>·</span>
                                <a asp-action="EditQuestion" asp-route-id="@q.Id">Edit</a>
                                <span>·</span>
                                <a asp-action="DeleteQuestion" asp-route-id="@q.Id">Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>
