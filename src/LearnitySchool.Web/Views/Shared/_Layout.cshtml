<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Public - LearnitySchool</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header style="padding:12px 16px; border-bottom:1px solid #e5e5e5;">
        <div style="display:flex; gap:12px; align-items:center; justify-content:space-between;">
            <div>
                <strong>LearnitySchool</strong>
                <span style="margin-left:10px; opacity:.7;">Public</span>
            </div>

            <div>
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit">Logout</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Login</a>
                }
            </div>
        </div>
        <nav style="margin-top:10px;">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span style="margin:0 8px;">|</span>
            <a asp-controller="Teacher" asp-action="Index">Teacher</a>
            <span style="margin:0 8px;">|</span>
            <a asp-controller="Student" asp-action="Index">Student</a>
            <span style="margin:0 8px;">|</span>
            <a asp-controller="Manager" asp-action="Index">Manager</a>
            <span style="margin:0 8px;">|</span>
            <a asp-controller="Groups" asp-action="Index">Groups</a>
        </nav>
    </header>

    <main style="padding:16px;">
        @RenderBody()
    </main>

    @RenderSection("Scripts", required: false)
</body>
</html>
