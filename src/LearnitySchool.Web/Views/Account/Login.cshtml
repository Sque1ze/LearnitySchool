@model LearnitySchool.Web.ViewModels.Auth.LoginVm
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login • LearnitySchool</title>

    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <main class="auth">
        <div class="lang-switch" data-lang-switch>
            <button type="button" data-lang="uk">UA</button>
            <button type="button" data-lang="en">EN</button>
        </div>

        <div class="auth-shell">
            <section class="auth-hero">
                <div>
                    <div class="auth-hero__badge">✨ LearnitySchool</div>
                    <h2>Навчання, яке хочеться відкривати щодня.</h2>
                    <p>Світла, зручна платформа для учнів, викладачів і менеджерів: курси, уроки, практичні завдання, квізи та перевірка робіт.</p>
                </div>
                <div class="auth-benefits">
                    <div class="auth-benefit"><span>🎓</span>Курси та уроки в одному місці</div>
                    <div class="auth-benefit"><span>💻</span>Практика з живим редактором коду</div>
                    <div class="auth-benefit"><span>🔔</span>Сповіщення та прогрес без хаосу</div>
                </div>
            </section>

        <section class="card">
            <div class="card__header">
                <div class="brand">
                    <div class="brand__dot"></div>
                    <div class="brand__text">LearnitySchool</div>
                </div>

                <h1 class="title">Вхід</h1>
                <p class="subtitle">Увійди, щоб продовжити</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert--validation">
                    <strong>Перевір форму</strong>
                    @Html.ValidationSummary(excludePropertyErrors: true)
                </div>
            }

            <form asp-action="Login" asp-controller="Account" method="post" class="form" novalidate>
                @Html.AntiForgeryToken()

                <div class="field @(ViewData.ModelState.ContainsKey(nameof(Model.Email))
                                                                               && ViewData.ModelState[nameof(Model.Email)]!.Errors.Count > 0 ? "field--invalid" : "")">
                    <label class="label" asp-for="Email">Email</label>
                    <input class="input"
                           asp-for="Email"
                           type="email"
                           autocomplete="email"
                           placeholder="name@example.com" />
                    <span class="validation" asp-validation-for="Email"></span>
                </div>

                <div class="field @(ViewData.ModelState.ContainsKey(nameof(Model.Password))
                                                                               && ViewData.ModelState[nameof(Model.Password)]!.Errors.Count > 0 ? "field--invalid" : "")">
                    <label class="label" asp-for="Password">Пароль</label>
                    <input class="input"
                           asp-for="Password"
                           type="password"
                           autocomplete="current-password"
                           placeholder="••••••••" />
                    <span class="validation" asp-validation-for="Password"></span>
                </div>

                <div class="field" style="margin-top: 2px;">
                    <label class="remember-row">
                        <input asp-for="RememberMe" type="checkbox" />
                        Запам’ятати мене
                    </label>
                </div>

                <button type="submit" class="btn btn--primary">Увійти</button>
            </form>

            <div class="footer">
                <span class="muted">Немає акаунту?</span>
                <a class="link" href="@Url.Action("Register", "Account")">Зареєструватися</a>
            </div>
        </section>

        </div>
    </main>

    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/language.js" asp-append-version="true"></script>
</body>
</html>
