@model LearnitySchool.Web.ViewModels.Auth.RegisterVm
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Register • LearnitySchool</title>

    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
    <main class="auth">
        <div class="fx" aria-hidden="true">
            <div class="fx__stars"></div>
            <div class="fx__stars fx__stars--2"></div>

            <div class="fx__container">
                <div class="fx__content">
                    <div class="fx__numbers">
                        <div class="fx__number"></div>
                        <div class="fx__number"></div>
                        <div class="fx__number"></div>
                        <div class="fx__number"></div>
                        <div class="fx__number"></div>
                        <div class="fx__number"></div>
                        <div class="fx__number"></div>
                        <div class="fx__number"></div>
                        <div class="fx__number"></div>
                    </div>
                </div>
            </div>
        </div>

        <section class="card">
            <div class="card__header">
                <div class="brand">
                    <div class="brand__dot"></div>
                    <div class="brand__text">LearnitySchool</div>
                </div>

                <h1 class="title">Реєстрація</h1>
                <p class="subtitle">Створи акаунт за хвилину</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert--validation">
                    <strong>Перевір форму</strong>
                    @Html.ValidationSummary(excludePropertyErrors: true)
                </div>
            }

            <form asp-action="Register" asp-controller="Account" method="post" class="form" novalidate>
                @Html.AntiForgeryToken()

                <div class="grid">
                    <div class="field @(ViewData.ModelState.ContainsKey(nameof(Model.FirstName))
                                                                                           && ViewData.ModelState[nameof(Model.FirstName)]!.Errors.Count > 0 ? "field--invalid" : "")">
                        <label class="label" asp-for="FirstName">Імʼя</label>
                        <input class="input"
                               asp-for="FirstName"
                               autocomplete="given-name"
                               placeholder="Оксана" />
                        <span class="validation" asp-validation-for="FirstName"></span>
                    </div>

                    <div class="field @(ViewData.ModelState.ContainsKey(nameof(Model.LastName))
                                                                                           && ViewData.ModelState[nameof(Model.LastName)]!.Errors.Count > 0 ? "field--invalid" : "")">
                        <label class="label" asp-for="LastName">Прізвище</label>
                        <input class="input"
                               asp-for="LastName"
                               autocomplete="family-name"
                               placeholder="Леторак" />
                        <span class="validation" asp-validation-for="LastName"></span>
                    </div>
                </div>

                <div class="field @(ViewData.ModelState.ContainsKey(nameof(Model.Email))
                                                                               && ViewData.ModelState[nameof(Model.Email)]!.Errors.Count > 0 ? "field--invalid" : "")">
                    <label class="label" asp-for="Email">Email</label>
                    <input class="input"
                           asp-for="Email"
                           type="email"
                           autocomplete="email"
                           placeholder="name@example.com" />
                    <span class="validation" asp-validation-for="Email"></span>
                </div>

                <div class="field @(ViewData.ModelState.ContainsKey(nameof(Model.Password))
                                                                               && ViewData.ModelState[nameof(Model.Password)]!.Errors.Count > 0 ? "field--invalid" : "")">
                    <label class="label" asp-for="Password">Пароль</label>
                    <input class="input"
                           asp-for="Password"
                           type="password"
                           autocomplete="new-password"
                           placeholder="мінімум 6 символів" />
                    <span class="validation" asp-validation-for="Password"></span>
                </div>

                <div class="field @(ViewData.ModelState.ContainsKey(nameof(Model.ConfirmPassword))
                                                                               && ViewData.ModelState[nameof(Model.ConfirmPassword)]!.Errors.Count > 0 ? "field--invalid" : "")">
                    <label class="label" asp-for="ConfirmPassword">Підтвердження пароля</label>
                    <input class="input"
                           asp-for="ConfirmPassword"
                           type="password"
                           autocomplete="new-password"
                           placeholder="повтори пароль" />
                    <span class="validation" asp-validation-for="ConfirmPassword"></span>
                </div>

                <button type="submit" class="btn btn--primary">Створити акаунт</button>
            </form>

            <div class="footer">
                <span class="muted">Вже є акаунт?</span>
                <a class="link" href="@Url.Action("Login", "Account")">Увійти</a>
            </div>
        </section>

        <div class="bg-glow"></div>
    </main>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
