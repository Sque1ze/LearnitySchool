@model LearnitySchool.Web.ViewModels.Manager.Practice.PracticeEditVm

@{
    ViewData["Title"] = "Practice builder";
}

<link rel="stylesheet" href="~/css/userManager/practice.css" asp-append-version="true" />

<div class="users-page">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="users-header">
        <div>
            <h2 class="users-title">Practice builder — <span class="muted">@Model.TaskTitle</span></h2>
            <div class="sub">Умова + Starter + Reference (HTML/CSS/JS)</div>
        </div>

        <div class="header-actions">
            <a asp-controller="ManagerTasks"
               asp-action="Index"
               asp-route-lessonId="@Model.LessonId"
               class="btn btn-muted">← Back</a>

            <button type="submit" form="practiceForm" class="btn btn-primary">Save</button>
        </div>
    </div>

    <form id="practiceForm" asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="TaskId" value="@Model.TaskId" />
        <input type="hidden" name="LessonId" value="@Model.LessonId" />
        <input type="hidden" name="CourseId" value="@Model.CourseId" />
        <input type="hidden" name="TaskTitle" value="@Model.TaskTitle" />

        <div class="practice-grid">

            <section class="card">
                <div class="card-title">Statement</div>
                <textarea name="Statement" rows="7" class="textarea">@Model.Statement</textarea>
            </section>

            <section class="card threshold-card">
                <div class="card-title">Threshold (%)</div>
                <input name="SimilarityThreshold" value="@Model.SimilarityThreshold" class="input" />
                <div class="hint">Рекомендовано: 70–90</div>
            </section>

            <section class="practice-two">
                <div class="card">
                    <div class="card-title">Starter</div>

                    <div class="tabs" data-group="starter">
                        <button type="button" class="tab is-active" data-tab="html">HTML</button>
                        <button type="button" class="tab" data-tab="css">CSS</button>
                        <button type="button" class="tab" data-tab="js">JS</button>
                    </div>

                    <div class="pane" data-pane="starter:html">
                        <textarea name="StarterHtml" rows="14" class="textarea code">@Model.StarterHtml</textarea>
                    </div>
                    <div class="pane" data-pane="starter:css" hidden>
                        <textarea name="StarterCss" rows="14" class="textarea code">@Model.StarterCss</textarea>
                    </div>
                    <div class="pane" data-pane="starter:js" hidden>
                        <textarea name="StarterJs" rows="14" class="textarea code">@Model.StarterJs</textarea>
                    </div>
                </div>

                <div class="card">
                    <div class="card-title">Reference <span class="card-title-muted">(не показувати студенту)</span></div>

                    <div class="tabs" data-group="ref">
                        <button type="button" class="tab is-active" data-tab="html">HTML</button>
                        <button type="button" class="tab" data-tab="css">CSS</button>
                        <button type="button" class="tab" data-tab="js">JS</button>
                    </div>

                    <div class="pane" data-pane="ref:html">
                        <textarea name="ReferenceHtml" rows="14" class="textarea code">@Model.ReferenceHtml</textarea>
                    </div>
                    <div class="pane" data-pane="ref:css" hidden>
                        <textarea name="ReferenceCss" rows="14" class="textarea code">@Model.ReferenceCss</textarea>
                    </div>
                    <div class="pane" data-pane="ref:js" hidden>
                        <textarea name="ReferenceJs" rows="14" class="textarea code">@Model.ReferenceJs</textarea>
                    </div>
                </div>
            </section>

            <div asp-validation-summary="All" class="validation"></div>

        </div>
    </form>

</div>

@section Scripts {
    <script>
        document.querySelectorAll(".tabs").forEach(tabs => {
            const group = tabs.getAttribute("data-group");

            tabs.querySelectorAll(".tab").forEach(btn => {
                btn.addEventListener("click", () => {
                    const key = btn.getAttribute("data-tab"); 

                    tabs.querySelectorAll(".tab").forEach(b => b.classList.remove("is-active"));
                    btn.classList.add("is-active");

                    document.querySelectorAll(`[data-pane^="${group}:"]`).forEach(p => p.hidden = true);
                    const target = document.querySelector(`[data-pane="${group}:${key}"]`);
                    if (target) target.hidden = false;
                });
            });
        });
    </script>
}
