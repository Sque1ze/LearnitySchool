@model LearnitySchool.Web.ViewModels.Manager.Lessons.LessonEditVm
@{
    ViewData["Title"] = "Create Lesson";
}

<link rel="stylesheet" href="~/css/userManager/lessonCreate.css" asp-append-version="true" />

<div class="users-page">

    <div class="users-header">
        <div>
            <h2 class="users-title">Create Lesson — <span class="muted">@Model.CourseTitle</span></h2>
            <div class="sub">Створіть урок і додайте контент</div>
        </div>

        <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="btn btn-muted">← Back</a>
    </div>

    <form asp-action="Create" method="post" class="card lesson-form">
        @Html.AntiForgeryToken()

        <input type="hidden" name="CourseId" value="@Model.CourseId" />

        <div class="form-grid">

            <div class="grid-2">
                <div class="field">
                    <label class="label">Order</label>
                    <input name="Order" value="@Model.Order" placeholder="Напр. 1" class="input" />
                </div>

                <div class="field">
                    <label class="label">Title</label>
                    <input name="Title" value="@Model.Title" placeholder="Назва уроку" class="input" />
                </div>
            </div>

            <div class="field">
                <label class="label">Description (опційно)</label>
                <textarea name="Description" placeholder="Короткий опис" class="textarea" rows="3">@Model.Description</textarea>
            </div>
            <div class="grid-2">
                <div class="field">
                    <label class="label">Ціна уроку</label>
                    <input name="PriceAmount" value="@Model.PriceAmount" placeholder="0 = безкоштовно" class="input" type="number" min="0" step="0.01" />
                    <div class="hint">Якщо ціна більша за 0, учень має оплатити урок перед доступом.</div>
                </div>

                <div class="field">
                    <label class="label">Валюта</label>
                    <input name="Currency" value="@Model.Currency" placeholder="UAH" class="input" maxlength="8" />
                </div>
            </div>


            <div class="field">
                <label class="label">Content</label>
                <textarea name="Content" placeholder="Markdown / текст / посилання" class="textarea textarea-lg" rows="12">@Model.Content</textarea>
                <div class="hint">Порада: можна вставляти посилання, чек-листи, markdown.</div>
            </div>

            <label class="check">
                <input type="checkbox" name="IsPublished" value="true" @(Model.IsPublished ? "checked" : "") />
                <span class="check__box" aria-hidden="true"></span>
                <span class="check__text">Опублікувати урок</span>
            </label>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="btn">Cancel</a>
            </div>

            <div asp-validation-summary="All" class="validation"></div>
        </div>
    </form>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
