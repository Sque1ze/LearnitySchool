@model List<LearnitySchool.Web.ViewModels.Manager.Lessons.LessonListItemVm>
@{
    ViewData["Title"] = "Lessons";
    var courseId = (Guid)ViewBag.CourseId;
    var courseTitle = (string)ViewBag.CourseTitle;
}

<link rel="stylesheet" href="~/css/userManager/lessonsIndex.css" asp-append-version="true" />

<div class="users-page">

    <div class="users-header">
        <div>
            <h2 class="users-title">Lessons — <span class="muted">@courseTitle</span></h2>
            <div class="sub">Керуйте уроками цього курсу</div>
        </div>

        <div class="header-actions">
            <a asp-controller="ManagerCourses" asp-action="Index" class="btn btn-muted">← Back</a>
            <a asp-action="Create" asp-route-courseId="@courseId" class="btn btn-primary">+ Add lesson</a>
        </div>
    </div>

    <div class="card">
        <table class="users-table">
            <thead>
                <tr>
                    <th style="width:90px;">Order</th>
                    <th>Title</th>
                    <th style="width:160px;">Published</th>
                    <th style="width:260px;"></th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="empty">Немає уроків</td>
                    </tr>
                }
                else
                {
                    foreach (var l in Model)
                    {
                        <tr>
                            <td class="cell-muted">@l.Order</td>

                            <td>
                                <div class="lesson-title">@l.Title</div>
                            </td>

                            <td>
                                @if (l.IsPublished)
                                {
                                    <span class="pill pill-success">✅ Published</span>
                                }
                                else
                                {
                                    <span class="pill pill-muted">— Draft</span>
                                }
                            </td>

                            <td class="actions">
                                <a asp-controller="ManagerTasks"
                                       asp-action="Index"
                                       asp-route-lessonId="@l.Id">
                                    Tasks
                                </a>
                                <span>·</span>

                                <a asp-action="Edit" asp-route-id="@l.Id">Edit</a>
                                <span>·</span>

                                <a asp-action="Delete" asp-route-id="@l.Id">Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>
