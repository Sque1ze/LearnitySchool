@model List<LearnitySchool.Web.ViewModels.Manager.Lessons.LessonListItemVm>
@{
    ViewData["Title"] = "Lessons";
    var courseId = (Guid)ViewBag.CourseId;
    var courseTitle = (string)ViewBag.CourseTitle;
}

<div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
    <div>
        <h2 style="margin:0;">Lessons — @courseTitle</h2>
        <div style="opacity:.75; margin-top:4px;">Керуйте уроками цього курсу</div>
    </div>

    <div style="display:flex; gap:10px;">
        <a asp-controller="ManagerCourses" asp-action="Index" class="dropdown-btn">Back</a>
        <a asp-action="Create" asp-route-courseId="@courseId" class="dropdown-btn">+ Add lesson</a>
    </div>
</div>

<div style="margin-top:16px; overflow:auto;">
    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">Order</th>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">Title</th>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">Published</th>
                <th style="padding:10px; border-bottom:1px solid #1F2933;"></th>
            </tr>
        </thead>

        <tbody>
            @if (Model == null || Model.Count == 0)
            {
                <tr>
                    <td colspan="4" style="padding:14px; opacity:.75;">Немає уроків</td>
                </tr>
            }
            else
            {
                foreach (var l in Model)
                {
                    <tr>
                        <td style="padding:10px; border-bottom:1px solid #1F2933;">@l.Order</td>

                        <td style="padding:10px; border-bottom:1px solid #1F2933; font-weight:600;">
                            @l.Title
                        </td>

                        <td style="padding:10px; border-bottom:1px solid #1F2933;">
                            @(l.IsPublished ? "✅" : "—")
                        </td>

                        <!-- ✅ Ось тут кнопка TASKS -->
                        <td style="padding:10px; border-bottom:1px solid #1F2933; white-space:nowrap;">
                            <a asp-controller="ManagerTasks"
                               asp-action="Index"
                               asp-route-lessonId="@l.Id">
                                Tasks
                            </a>
                            <span style="opacity:.5;"> | </span>

                            <a asp-action="Edit" asp-route-id="@l.Id">Edit</a>
                            <span style="opacity:.5;"> | </span>

                            <a asp-action="Delete" asp-route-id="@l.Id">Delete</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
