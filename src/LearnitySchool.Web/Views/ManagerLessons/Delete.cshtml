@model LearnitySchool.Web.ViewModels.Manager.Lessons.LessonEditVm
@{
    ViewData["Title"] = "Delete Lesson";
}

<link rel="stylesheet" href="~/css/userManager/lessonDelete.css" asp-append-version="true" />

<div class="users-page">

    <div class="users-header">
        <div>
            <h2 class="users-title">Delete Lesson — <span class="muted">@Model.CourseTitle</span></h2>
            <div class="sub">Підтвердження видалення уроку</div>
        </div>

        <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="btn btn-muted">← Back</a>
    </div>

    <div class="card delete-card">

        <div class="delete-title">@Model.Order. @Model.Title</div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="delete-desc">@Model.Description</div>
        }

        <div class="danger-box">
            ⚠️ Урок буде видалений. (пізніше тут також будуть завдання)
        </div>

        <form asp-action="DeleteConfirmed" method="post" class="delete-actions">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="courseId" value="@Model.CourseId" />

            <button type="submit" class="btn btn-danger">Так, видалити</button>

            <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="btn">Cancel</a>
        </form>

    </div>

</div>
