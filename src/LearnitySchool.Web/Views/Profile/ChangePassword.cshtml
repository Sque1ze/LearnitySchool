@model LearnitySchool.Web.ViewModels.Profile.ChangePasswordVm
@{
    ViewData["Title"] = "Зміна пароля";
}
<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />

<section class="profile-page">
    <header class="profile-head">
        <div>
            <div class="kicker">Security</div>
            <h1>Зміна пароля</h1>
            <p>Введіть старий пароль і новий пароль.</p>
        </div>
        <a asp-action="Index" class="pbtn">← Назад</a>
    </header>

    <form asp-action="ChangePassword" method="post" class="profile-form small">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation"></div>

        <label>Старий пароль<input asp-for="OldPassword" /></label>
        <label>Новий пароль<input asp-for="NewPassword" /></label>
        <label>Підтвердження нового пароля<input asp-for="ConfirmPassword" /></label>

        <div class="profile-actions left">
            <button type="submit" class="pbtn pbtn-primary">Змінити пароль</button>
            <a asp-action="Index" class="pbtn">Скасувати</a>
        </div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
