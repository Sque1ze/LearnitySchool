@model LearnitySchool.Web.ViewModels.Manager.Users.UserEditVm
@{
    ViewData["Title"] = "Видалити користувача";
}
<link rel="stylesheet" href="~/css/userManager/userIndex.css" asp-append-version="true" />

<section class="manager-user-page">
    <header class="manager-user-head">
        <div>
            <h1>Видалити користувача</h1>
            <p>Цю дію потрібно підтвердити.</p>
        </div>
        <a asp-action="Index" class="manager-user-btn">← Назад</a>
    </header>

    <div class="manager-user-card">
        <p>Точно видалити <strong>@Model.Email</strong>?</p>
        <form asp-action="DeleteConfirmed" method="post" class="manager-user-actions">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="manager-user-btn danger">Delete</button>
            <a asp-action="Index" class="manager-user-btn">Cancel</a>
        </form>
    </div>
</section>
