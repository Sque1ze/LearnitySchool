@model LearnitySchool.Web.ViewModels.Manager.Users.UsersIndexVm
@{
    ViewData["Title"] = "Користувачі";
}

<div class="users-page">

    <div class="users-header">
        <h2 class="users-title">Користувачі</h2>
        <a asp-action="Create" class="btn btn-primary">+ Додати</a>
    </div>

    <form method="get" asp-action="Index" class="card users-filters">
        <input name="q"
               value="@Model.Q"
               class="input"
               placeholder="Пошук за ім’ям або прізвищем" />

        <select name="role" class="select">
            <option value="">Усі ролі</option>
            @foreach (var r in Model.AvailableRoles)
            {
                <option value="@r" selected="@(Model.Role == r)">
                    @r
                </option>
            }
        </select>

        <button type="submit" class="btn">Фільтрувати</button>
        <a asp-action="Index" class="btn btn-muted">Скинути</a>
    </form>

    <div class="card">
        <table class="users-table">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Ім’я</th>
                    <th>Прізвище</th>
                    <th>Role</th>
                    <th>Age</th>
                    <th>Phone</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Users == null || Model.Users.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="empty">
                            Немає користувачів
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var u in Model.Users)
                    {
                        <tr>
                            <td>@u.Email</td>
                            <td>@u.FirstName</td>
                            <td>@u.LastName</td>
                            <td>
                                <span class="role-badge @u.Role">@u.Role</span>
                            </td>
                            <td>@u.Age</td>
                            <td>@u.PhoneNumber</td>
                            <td class="actions">
                                <a asp-action="Details" asp-route-id="@u.Id">Details</a>
                                <span>·</span>
                                <a asp-action="Edit" asp-route-id="@u.Id">Edit</a>
                                <span>·</span>
                                <a asp-action="Delete" asp-route-id="@u.Id">Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/userManager/userIndex.css" />
}