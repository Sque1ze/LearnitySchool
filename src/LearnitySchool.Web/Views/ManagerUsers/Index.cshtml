@model List<LearnitySchool.Web.ViewModels.Manager.Users.UserListItemVm>
@{
    ViewData["Title"] = "Користувачі";
}

@if (TempData["Error"] != null)
{
    <div style="padding:10px; border:1px solid #1F2933; border-radius:12px; margin-bottom:12px;">
        @TempData["Error"]
    </div>
}

<div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
    <h2 style="margin:0;">Користувачі</h2>
    <a asp-action="Create" class="dropdown-btn">+ Додати</a>
</div>

<div style="margin-top:16px; overflow:auto;">
    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">Email</th>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">Ім'я</th>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">Прізвище</th>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">Role</th>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">Age</th>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">Phone</th>
                <th style="padding:10px; border-bottom:1px solid #1F2933;"></th>
            </tr>
        </thead>

        <tbody>
            @if (Model == null || Model.Count == 0)
            {
                <tr>
                    <td colspan="7" style="padding:14px; opacity:.75;">
                        Немає користувачів
                    </td>
                </tr>
            }
            else
            {
                @foreach (var u in Model)
                {
                    <tr>
                        <td style="padding:10px; border-bottom:1px solid #1F2933;">
                            @u.Email
                        </td>

                        <td style="padding:10px; border-bottom:1px solid #1F2933;">
                            @u.FirstName
                        </td>

                        <td style="padding:10px; border-bottom:1px solid #1F2933;">
                            @u.LastName
                        </td>

                        <td style="padding:10px; border-bottom:1px solid #1F2933;">
                            @u.Role
                        </td>

                        <td style="padding:10px; border-bottom:1px solid #1F2933;">
                            @u.Age
                        </td>

                        <td style="padding:10px; border-bottom:1px solid #1F2933;">
                            @u.PhoneNumber
                        </td>

                        <td style="padding:10px; border-bottom:1px solid #1F2933; white-space:nowrap;">
                            <a asp-action="Details" asp-route-id="@u.Id">Details</a>
                            <span style="opacity:.5;"> | </span>
                            <a asp-action="Edit" asp-route-id="@u.Id">Edit</a>
                            <span style="opacity:.5;"> | </span>
                            <a asp-action="Delete" asp-route-id="@u.Id">Delete</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
