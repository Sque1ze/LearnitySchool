@model LearnitySchool.Web.ViewModels.Manager.Users.UserCreateVm
@{
    ViewData["Title"] = "Додати користувача";
}

<h2>Додати користувача</h2>

<form asp-action="Create" method="post" style="max-width:520px; display:grid; gap:12px;">
    @Html.AntiForgeryToken()

    <input name="Email" value="@Model.Email" placeholder="Email" class="dropdown-btn" />
    <input name="Password" type="password" placeholder="Password" class="dropdown-btn" />

    <input name="FirstName" value="@Model.FirstName" placeholder="First name" class="dropdown-btn" />
    <input name="LastName" value="@Model.LastName" placeholder="Last name" class="dropdown-btn" />

    <label style="opacity:.8;">Role</label>
    <select name="Role" class="dropdown-btn">
        @foreach (var r in Model.AvailableRoles)
        {
            <option value="@r" selected="@(Model.Role == r)">@r</option>
        }
    </select>

    <input name="Age" value="@Model.Age" placeholder="Age" class="dropdown-btn" />
    <input name="PhoneNumber" value="@Model.PhoneNumber" placeholder="Phone number" class="dropdown-btn" />

    <div style="display:flex; gap:10px;">
        <button type="submit" class="dropdown-btn">Create</button>
        <a asp-action="Index" class="dropdown-btn">Cancel</a>
    </div>

    <div asp-validation-summary="All"></div>
</form>
