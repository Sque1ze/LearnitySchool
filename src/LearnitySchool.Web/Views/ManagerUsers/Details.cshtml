@model LearnitySchool.Web.ViewModels.Manager.Users.UserEditVm
@{
    ViewData["Title"] = "Дані користувача";
}
<link rel="stylesheet" href="~/css/userManager/userIndex.css" asp-append-version="true" />

<section class="manager-user-page">
    <header class="manager-user-head">
        <div>
            <h1>Дані користувача</h1>
            <p>Перегляд основної інформації про акаунт.</p>
        </div>
        <a asp-action="Index" class="manager-user-btn">← Назад</a>
    </header>

    <div class="manager-user-card">
        <div class="detail-grid">
            <strong>Email</strong><div>@Model.Email</div>
            <strong>UserName</strong><div>@Model.UserName</div>
            <strong>First name</strong><div>@Model.FirstName</div>
            <strong>Last name</strong><div>@Model.LastName</div>
            <strong>Age</strong><div>@Model.Age</div>
            <strong>Phone</strong><div>@Model.PhoneNumber</div>
            <strong>Role</strong><div><span class="role-badge @Model.Role">@Model.Role</span></div>
        </div>
        <div class="manager-user-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="manager-user-btn primary">Edit</a>
            <a asp-action="Index" class="manager-user-btn">Back</a>
        </div>
    </div>
</section>
