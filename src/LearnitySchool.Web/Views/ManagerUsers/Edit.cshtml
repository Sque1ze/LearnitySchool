@model LearnitySchool.Web.ViewModels.Manager.Users.UserEditVm
@{
    ViewData["Title"] = "Редагувати користувача";
}


<link rel="stylesheet" href="~/css/userManager/userIndex.css" asp-append-version="true" />

<section class="manager-user-page">
    <header class="manager-user-head">
        <div>
            <div class="kicker">Manager</div>
            <h1>Редагувати користувача</h1>
            <p>Оновлення даних і ролі.</p>
        </div>
        <a asp-action="Index" class="manager-user-btn">← Назад</a>
    </header>

    <form asp-action="Edit" method="post" class="manager-user-form manager-user-card">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="validation"></div>
        <div class="form-grid-2">
            <label>Email<input asp-for="Email" /></label>
            <label>UserName<input asp-for="UserName" /></label>
            <label>First name<input asp-for="FirstName" /></label>
            <label>Last name<input asp-for="LastName" /></label>
            <label>Role
                <select asp-for="Role">
                    @foreach (var r in Model.AvailableRoles)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </label>
            <label>Age<input asp-for="Age" type="number" /></label>
            <label>Phone<input asp-for="PhoneNumber" /></label>
        </div>
        <div class="manager-user-actions">
            <button type="submit" class="manager-user-btn primary">Save</button>
            <a asp-action="Index" class="manager-user-btn">Back</a>
        </div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
