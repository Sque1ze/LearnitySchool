@model List<LearnitySchool.Web.ViewModels.Student.StudentLessonVm>

@{
    ViewData["Title"] = "Lessons";
    var courseId = (Guid)ViewBag.CourseId;
}

<div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
    <div>
        <h2 style="margin:0;">Lessons</h2>
        <div style="opacity:.75; margin-top:4px;">Оберіть урок і дивіться завдання + прогрес</div>
    </div>

    <a asp-action="Index" class="dropdown-btn">← Back to courses</a>
</div>

<div style="margin-top:16px; overflow:auto;">
    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">#</th>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">Title</th>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">Tasks</th>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">Done</th>
                <th style="text-align:left; padding:10px; border-bottom:1px solid #1F2933;">Progress</th>
                <th style="padding:10px; border-bottom:1px solid #1F2933;"></th>
            </tr>
        </thead>

        <tbody>
            @if (Model == null || Model.Count == 0)
            {
                <tr>
                    <td colspan="6" style="padding:14px; opacity:.75;">Немає уроків</td>
                </tr>
            }
            else
            {
                @foreach (var l in Model)
                {
                    <tr>
                        <td style="padding:10px; border-bottom:1px solid #1F2933;">@l.Order</td>

                        <td style="padding:10px; border-bottom:1px solid #1F2933; font-weight:600;">
                            @l.Title
                        </td>

                        <td style="padding:10px; border-bottom:1px solid #1F2933;">@l.TasksCount</td>

                        <td style="padding:10px; border-bottom:1px solid #1F2933;">
                            @l.CompletedTasks / @l.TasksCount
                        </td>

                        <td style="padding:10px; border-bottom:1px solid #1F2933; min-width:200px;">
                            <div style="display:flex; justify-content:space-between; font-size:13px; opacity:.85;">
                                <span>@l.ProgressPercent%</span>
                            </div>

                            <div style="height:10px; background:#1F2933; border-radius:999px; overflow:hidden; margin-top:6px;">
                                <div style="height:10px; width:@l.ProgressPercent%; background:#22C55E;"></div>
                            </div>
                        </td>

                        <td style="padding:10px; border-bottom:1px solid #1F2933; white-space:nowrap;">
                            <a asp-controller="Student"
                               asp-action="Tasks"
                               asp-route-lessonId="@l.LessonId"
                               class="dropdown-btn">
                                Open tasks
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
