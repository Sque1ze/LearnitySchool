@model List<LearnitySchool.Web.ViewModels.Student.StudentLessonVm>

@{
    ViewData["Title"] = "Lessons";
    var courseId = (Guid)ViewBag.CourseId;
}

<link rel="stylesheet" href="~/css/student/lessons.css" asp-append-version="true" />

<div class="lessons-page">

    <div class="lessons-head">
        <div>
            <div class="kicker">STUDENT</div>
            <h1 class="h1">Уроки</h1>
            <div class="sub">Оберіть урок і дивіться завдання + прогрес</div>
        </div>

        <a asp-action="Index" class="btn btn-ghost">← Back to courses</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="panel table-panel">
        <table class="table">
            <thead>
                <tr>
                    <th style="width:70px;">#</th>
                    <th>Title</th>
                    <th style="width:110px;">Tasks</th>
                    <th style="width:130px;">Done</th>
                    <th style="width:280px;">Progress</th>
                    <th style="width:170px;"></th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="empty">Немає уроків</td>
                    </tr>
                }
                else
                {
                    foreach (var l in Model)
                    {
                        var locked = !l.IsOpen;

                        <tr class="row @(locked ? "row-locked" : "")">
                            <td class="cell-muted">@l.Order</td>

                            <td class="strong">
                                <div class="title-wrap">
                                    <span>@l.Title</span>

                                    @if (locked)
                                    {
                                        <span class="pill pill-muted pill-lock">🔒 Закритий</span>
                                    }
                                    else
                                    {
                                        <span class="pill pill-success pill-open">Відкритий</span>
                                    }
                                </div>
                            </td>

                            <td>@l.TasksCount</td>

                            <td class="cell-muted">
                                @l.CompletedTasks / @l.TasksCount
                            </td>

                            <td>
                                <div class="progress-top">
                                    <span class="cell-muted">@l.ProgressPercent%</span>
                                </div>

                                <div class="progress-bar">
                                    <div class="progress-fill" style="width:@l.ProgressPercent%;"></div>
                                </div>
                            </td>

                            <td class="actions">
                                @if (!locked)
                                {
                                    <a asp-controller="Student"
                                       asp-action="Tasks"
                                       asp-route-lessonId="@l.LessonId"
                                       class="btn btn-primary">
                                        Open tasks
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-ghost" disabled title="Урок закритий викладачем">
                                        Недоступно
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>
