@model List<LearnitySchool.Web.ViewModels.Student.StudentCourseVm>

@{
    ViewData["Title"] = "Мої Курси";
}
<link rel="stylesheet" href="~/css/student/student-courses.css" asp-append-version="true" />
<section class="sc-page">
    <header class="sc-head">
        <h1 class="sc-title">Мої курси</h1>
        <div class="sc-subtitle">Ваші курси та прогрес</div>
    </header>

    @if (Model == null || Model.Count == 0)
    {
        <div class="sc-empty">
            <div class="sc-empty__icon">📚</div>
            <div class="sc-empty__title">Ви ще не записані на курси</div>
            <div class="sc-empty__text">Коли менеджер додасть курс — він з’явиться тут, і ви побачите прогрес.</div>
        </div>
    }
    else
    {
        <div class="sc-grid">
            @foreach (var c in Model)
            {
                <article class="sc-card">
                    <div class="sc-card__top">
                        <div class="sc-card__title">@c.Title</div>
                        <div class="sc-badge">
                            <span class="sc-badge__dot"></span>
                            <span>@c.LessonsCount Уроки</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(c.Description))
                    {
                        <div class="sc-card__desc">@c.Description</div>
                    }

                    <div class="sc-progress">
                        <div class="sc-progress__meta">
                            <span class="sc-progress__left">@c.CompletedTasks / @c.TotalTasks tasks</span>
                            <span class="sc-progress__right">@c.ProgressPercent%</span>
                        </div>

                        <div class="sc-progress__track" role="progressbar"
                             aria-valuenow="@c.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                            <div class="sc-progress__fill" style="width:@c.ProgressPercent%"></div>
                        </div>
                    </div>

                    <div class="sc-actions">
                        <a asp-action="Lessons"
                               asp-route-courseId="@c.CourseId"
                               class="sc-btn sc-btn--primary">
                            Відкрити
                            <span class="sc-btn__arrow">→</span>
                        </a>
                    </div>
                </article>
            }
        </div>
    }
</section>
