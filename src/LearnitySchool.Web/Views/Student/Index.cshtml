@model List<LearnitySchool.Web.ViewModels.Student.StudentCourseVm>

@{
    ViewData["Title"] = "My Courses";
}

<h2 style="margin:0;">My Courses</h2>
<div style="opacity:.75; margin-top:4px;">Ваші курси та прогрес</div>

@if (Model == null || Model.Count == 0)
{
    <div style="opacity:.7; margin-top:16px;">Ви ще не записані на курси</div>
}
else
{
    <div style="margin-top:16px; display:grid; gap:12px;">
        @foreach (var c in Model)
        {
            <div style="border:1px solid #1F2933; border-radius:12px; padding:14px;">
                <div style="font-weight:700; font-size:16px;">@c.Title</div>

                @if (!string.IsNullOrWhiteSpace(c.Description))
                {
                    <div style="opacity:.75; margin-top:6px;">@c.Description</div>
                }

                <div style="margin-top:10px; opacity:.85;">
                    Lessons: <strong>@c.LessonsCount</strong>
                </div>

                <div style="margin-top:10px;">
                    <div style="display:flex; justify-content:space-between; font-size:13px; opacity:.85;">
                        <span>@c.CompletedTasks / @c.TotalTasks tasks</span>
                        <span>@c.ProgressPercent%</span>
                    </div>

                    <div style="height:10px; background:#1F2933; border-radius:999px; overflow:hidden; margin-top:6px;">
                        <div style="height:10px; width:@c.ProgressPercent%; background:#22C55E;"></div>
                    </div>
                </div>

                <a asp-action="Lessons"
                   asp-route-courseId="@c.CourseId"
                   class="dropdown-btn"
                   style="margin-top:12px; display:inline-block;">
                    Open
                </a>
            </div>
        }
    </div>
}
