@using LearnitySchool.Domain.Enums
@model List<LearnitySchool.Web.ViewModels.Student.StudentTaskVm>

@{
    ViewData["Title"] = "Завдання";
    var lessonId = (Guid)ViewBag.LessonId;
    var courseId = (Guid)ViewBag.CourseId;
}
<link rel="stylesheet" href="~/css/student/student-tasks.css" asp-append-version="true" />

<section class="st-page">
    <header class="st-head">
        <div>
            <h1 class="st-title">Завдання</h1>
            <div class="st-subtitle">Завдання цього уроку</div>
        </div>

        <a asp-action="Lessons"
           asp-route-courseId="@courseId"
           class="st-btn st-btn--ghost">
            <span class="st-btn__arrow">←</span>
            Назад до уроків
        </a>
    </header>

    @if (TempData["Error"] != null)
    {
        <div class="st-alert st-alert--error">❌ @TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="st-alert st-alert--success">@TempData["Success"]</div>
    }

    <div class="st-surface">
        <div class="st-table-wrap">
            <table class="st-table">
                <thead>
                    <tr>
                        <th class="st-th st-th--num">#</th>
                        <th class="st-th">Назва завдання</th>
                        <th class="st-th">Тип</th>
                        <th class="st-th">Перевірка</th>
                        <th class="st-th">Статус</th>
                        <th class="st-th st-th--actions"></th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="st-empty">
                                <div class="st-empty__icon">✅</div>
                                <div class="st-empty__title">Немає завдань для цього уроку</div>
                                <div class="st-empty__text">Коли викладач додасть завдання — воно з’явиться тут.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var t in Model)
                        {
                            <tr class="st-tr @(t.IsFailedAttempt ? "st-tr--failed" : "")">
                                <td class="st-td st-td--num">@t.Order</td>

                                <td class="st-td">
                                    <div class="st-task-title">@t.Title</div>
                                    @if (!string.IsNullOrWhiteSpace(t.TeacherComment))
                                    {
                                        <div class="st-note">Коментар вчителя: @t.TeacherComment</div>
                                    }
                                </td>

                                <td class="st-td">
                                    <span class="st-pill st-pill--type">@t.Type</span>
                                </td>

                                <td class="st-td">
                                    @if (t.AssessmentMode == TaskAssessmentMode.TeacherReview)
                                    {
                                        <span class="st-pill st-pill--review">На перевірку</span>
                                    }
                                    else
                                    {
                                        <span class="st-pill st-pill--auto">% автоматично</span>
                                    }
                                </td>

                                <td class="st-td">
                                    @if (t.IsCompleted)
                                    {
                                        <span class="st-pill st-pill--ok">✅ Зараховано</span>
                                    }
                                    else if (t.SubmissionStatus == StudentSubmissionStatus.PendingReview)
                                    {
                                        <span class="st-pill st-pill--pending">🟡 Очікує перевірки</span>
                                    }
                                    else if (t.SubmissionStatus == StudentSubmissionStatus.Returned)
                                    {
                                        <span class="st-pill st-pill--returned">🔴 Не зараховано</span>
                                        @if (t.SubmittedAtUtc.HasValue)
                                        {
                                            <div class="st-note st-note--danger">Можна переробити і здати ще раз.</div>
                                        }
                                    }
                                    else if (t.HasQuizAttempt && (t.QuizScorePercent ?? 0) < 95)
                                    {
                                        <span class="st-pill st-pill--returned">🔴 @t.QuizScorePercent% — спробуй ще</span>
                                        <div class="st-note st-note--danger">Правильні відповіді не показуються, можна повторити.</div>
                                    }
                                    else
                                    {
                                        <span class="st-pill st-pill--muted">⏳ Не виконано</span>
                                    }
                                </td>

                                <td class="st-td st-td--actions">
                                    @if (t.Type == LessonTaskType.Practice)
                                    {
                                        <a asp-action="Practice"
                                           asp-route-taskId="@t.TaskId"
                                           class="st-btn st-btn--primary">
                                            @(t.SubmissionStatus == StudentSubmissionStatus.Returned ? "Переробити" : "Відкрити")
                                            <span class="st-btn__arrow">→</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Quiz"
                                           asp-route-taskId="@t.TaskId"
                                           class="st-btn st-btn--primary">
                                            Відкрити
                                            <span class="st-btn__arrow">→</span>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
