@using LearnitySchool.Domain.Enums
@model LearnitySchool.Web.ViewModels.Student.StudentPracticeVm

@{
    ViewData["Title"] = "Practice";

    var submitTitle = Model.IsTeacherReview
        ? "Здати роботу на перевірку вчителю"
        : "Можна здати навіть якщо менше 95%, але тоді завдання буде червоним і його можна переробити";

    var submitText = Model.IsTeacherReview
        ? "Здати роботу 🟡"
        : "Здати роботу";
}

<link rel="stylesheet" href="~/css/student/practice.css" asp-append-version="true" />

<div class="practice-page">

    <div class="practice-head">
        <div class="practice-title">
            <div class="kicker">Practice task</div>
            <h2>@Model.Title</h2>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="desc">@Model.Description</p>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Statement))
        {
            <div class="practice-statement">
                <div class="statement-title">Умова завдання</div>
                <div class="statement-text">@Model.Statement</div>
            </div>
        }

        <div class="practice-mode-card @(Model.IsTeacherReview ? "is-review" : "is-auto")">
            @if (Model.IsTeacherReview)
            {
                <div class="mode-title">🟡 Режим: здача на перевірку</div>
                <div class="mode-text">
                    Після натискання “Здати роботу” завдання буде очікувати перевірки вчителя.
                </div>
            }
            else
            {
                <div class="mode-title">% Режим: автоматична перевірка</div>
                <div class="mode-text">
                    Натисни Check, щоб побачити відсоток. Для зарахування потрібно @Model.SimilarityThreshold% або більше, але здати можна і менший результат — він буде червоним, і завдання можна переробити.
                </div>
            }
        </div>

        @if (Model.SubmissionStatus != null)
        {
            <div class="practice-status-card">
                @if (Model.SubmissionStatus == StudentSubmissionStatus.PendingReview)
                {
                    <strong>🟡 Робота очікує перевірки.</strong>
                }
                else if (Model.SubmissionStatus == StudentSubmissionStatus.Approved)
                {
                    <strong>✅ Роботу зараховано.</strong>
                }
                else if (Model.SubmissionStatus == StudentSubmissionStatus.Returned)
                {
                    <strong>🔁 Роботу повернуто на доопрацювання.</strong>
                }

                @if (Model.SubmittedAtUtc.HasValue)
                {
                    <span>
                        Здано: @Model.SubmittedAtUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.TeacherComment))
                {
                    <div class="teacher-comment">
                        Коментар вчителя: @Model.TeacherComment
                    </div>
                }
            </div>
        }

        <div class="practice-actions">
            <a asp-controller="Student"
               asp-action="Tasks"
               asp-route-lessonId="@Model.LessonId"
               class="btn btn-ghost">
                ← Back
            </a>

            <button type="button" id="runBtn" class="btn btn-primary">
                Run ▶
            </button>

            @if (Model.IsTeacherReview)
            {
                <button type="button"
                        id="checkBtn"
                        class="btn btn-secondary"
                        title="Необов’язково: можна подивитися приблизний %">
                    Check %
                </button>
            }
            else
            {
                <button type="button" id="checkBtn" class="btn btn-secondary">
                    Check ✓
                </button>
            }

            <button type="button" id="resetBtn" class="btn btn-ghost" title="Reset to starter code">
                Reset ↺
            </button>

            <form id="submitForm"
                  asp-controller="Student"
                  asp-action="SubmitPractice"
                  method="post"
                  style="display:inline;">
                @Html.AntiForgeryToken()

                <input type="hidden" name="TaskId" value="@Model.TaskId" />
                <input type="hidden" name="LessonId" value="@Model.LessonId" />

                <input type="hidden" name="Html" id="submitHtml" />
                <input type="hidden" name="Css" id="submitCss" />
                <input type="hidden" name="Js" id="submitJs" />
                <input type="hidden" name="ClientSimilarity" id="submitSimilarity" value="0" />

                <button type="submit"
                        id="submitBtn"
                        class="btn btn-secondary"
                        data-mode="@((int)Model.AssessmentMode)"
                        data-is-review="@Model.IsTeacherReview.ToString().ToLower()"
                        data-threshold="@Model.SimilarityThreshold"
                        title="@submitTitle">
                    @submitText
                </button>
            </form>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="flash flash-error">
            ❌ @TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="flash flash-success">
            ✅ @TempData["Success"]
        </div>
    }

    <div class="practice-grid">

        <section class="panel editor-panel">

            <div class="tabs" role="tablist" aria-label="Code tabs">
                <button class="tab active" type="button" data-tab="html">HTML</button>
                <button class="tab" type="button" data-tab="css">CSS</button>
                <button class="tab" type="button" data-tab="js">JS</button>

                <div class="tab-right">
                    <span id="draftStatus" class="badge badge-muted">
                        @(Model.HasDraft
                            ? $"Draft: saved {Model.DraftUpdatedAt?.ToLocalTime():HH:mm:ss}"
                            : "Draft: —")
                    </span>

                    <span id="similarityBadge" class="badge badge-muted">
                        @(Model.IsTeacherReview
                            ? "Similarity: optional"
                            : $"Similarity: — (need {Model.SimilarityThreshold}%)")
                    </span>
                </div>
            </div>

            <div class="tab-content">
                <div class="tab-pane active" data-pane="html">
                    <div id="htmlEditor" class="monaco-host"></div>
                </div>

                <div class="tab-pane" data-pane="css">
                    <div id="cssEditor" class="monaco-host"></div>
                </div>

                <div class="tab-pane" data-pane="js">
                    <div id="jsEditor" class="monaco-host"></div>
                </div>
            </div>

            <div class="hint">
                <div class="hint-dot"></div>
                <div>
                    <div class="hint-title">Порада</div>
                    <div class="hint-text">
                        Тут працює Monaco Editor: підказки, автозакриття тегів, дужок і лапок.
                        Натисни <b>Run</b> — щоб побачити результат.

                        @if (Model.IsTeacherReview)
                        {
                            <span>
                                У цьому режимі можна одразу натиснути <b>Здати роботу</b>,
                                а вчитель перевірить її вручну.
                            </span>
                        }
                        else
                        {
                            <span>
                                Натисни <b>Check</b> — щоб порахувати %.
                                Для зарахування потрібно <b>@Model.SimilarityThreshold%</b>, але роботу можна здати й раніше — вона буде червоною до переробки.
                            </span>
                        }

                        @if (Model.HasReference)
                        {
                            <span>
                                Перемкнись на <b>Reference</b>, щоб бачити приклад.
                            </span>
                        }
                    </div>
                </div>
            </div>

        </section>

        <section class="panel preview-panel">

            <div class="preview-head">
                <div>
                    <div class="preview-title">Preview</div>
                    <div class="preview-sub">iframe sandbox</div>
                </div>

                <div class="preview-tabs">
                    <button type="button" class="btn btn-ghost active" id="previewTabBtn">
                        My preview
                    </button>

                    @if (Model.HasReference)
                    {
                        <button type="button" class="btn btn-ghost" id="referenceTabBtn">
                            Reference
                        </button>
                    }
                </div>
            </div>

            <div class="preview-wrap">
                <div id="overlay" class="overlay hidden">
                    <div class="overlay-card">
                        <div class="overlay-title">Checking…</div>
                        <div class="overlay-sub">Please wait</div>
                    </div>
                </div>

                <iframe id="previewFrame"
                        class="preview-iframe"
                        title="Preview"
                        sandbox="allow-scripts allow-forms allow-same-origin"></iframe>

                @if (Model.HasReference)
                {
                    <iframe id="referenceFrame"
                            class="preview-iframe"
                            title="Reference preview"
                            sandbox="allow-scripts allow-forms allow-same-origin"
                            style="display:none;"></iframe>
                }
            </div>

            <div class="console-panel">
                <div class="console-head">
                    <strong>Console</strong>
                    <button type="button" id="clearConsoleBtn" class="btn btn-ghost btn-small">Clear</button>
                </div>
                <div id="previewConsole" class="console-output">
                    <div class="console-empty">Console output зʼявиться тут після Run.</div>
                </div>
            </div>

            <div class="preview-footer">
                <div class="muted">
                    * JS виконується в iframe. Доступ до сайту/куків заблокований sandbox’ом.
                </div>
            </div>

        </section>

    </div>
</div>

<div id="taskMeta"
     data-taskid="@Model.TaskId"
     data-threshold="@Model.SimilarityThreshold"
     data-mode="@((int)Model.AssessmentMode)"
     data-is-review="@Model.IsTeacherReview.ToString().ToLower()"
     style="display:none;"></div>

<!-- Поточні значення для старту Monaco Editor -->
<textarea id="editorHtmlValue" style="display:none;">@Model.StarterHtml</textarea>
<textarea id="editorCssValue" style="display:none;">@Model.StarterCss</textarea>
<textarea id="editorJsValue" style="display:none;">@Model.StarterJs</textarea>

<!-- Оригінальний starter для Reset -->
<textarea id="starterHtml" style="display:none;">@Model.InitialHtml</textarea>
<textarea id="starterCss" style="display:none;">@Model.InitialCss</textarea>
<textarea id="starterJs" style="display:none;">@Model.InitialJs</textarea>

@if (Model.HasReference)
{
    <textarea id="refHtml" style="display:none;">@Model.ReferenceHtml</textarea>
    <textarea id="refCss" style="display:none;">@Model.ReferenceCss</textarea>
    <textarea id="refJs" style="display:none;">@Model.ReferenceJs</textarea>
}

@section Scripts {
    <script src="~/js/student/practice.js" asp-append-version="true"></script>
}